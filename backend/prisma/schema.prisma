generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  hashedPassword   String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  savedComparisons SavedComparison[]
  trackedProducts  TrackedProduct[]

  @@index([email])
}

model TrackedProduct {
  id             Int                   @id @default(autoincrement())
  userId         Int
  user           User                  @relation(fields: [userId], references: [id])
  productUrl     String
  productName    String
  platform       String
  imageUrl       String?
  searchQuery    String?
  lastKnownPrice Float?
  alertThreshold Float?
  alertEnabled   Boolean               @default(false)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lastCheckedAt  DateTime?
  priceHistory   TrackedPriceHistory[]

  @@unique([userId, productUrl])
  @@index([userId])
  @@index([isActive])
}

model TrackedPriceHistory {
  id               Int            @id @default(autoincrement())
  trackedProductId Int
  trackedProduct   TrackedProduct @relation(fields: [trackedProductId], references: [id], onDelete: Cascade)
  price            Float
  currency         String         @default("NGN")
  availability     Boolean        @default(true)
  recordedAt       DateTime       @default(now())

  @@index([trackedProductId, recordedAt])
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  productUrl String
  platform   String
  price      Float
  currency   String
  recordedAt DateTime @default(now())

  @@unique([productUrl, platform])
  @@index([productUrl, platform, recordedAt])
}

model SavedComparison {
  id             Int      @id @default(autoincrement())
  userId         Int
  searchQuery    String
  searchType     String
  comparisonData String
  productUrl     String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, productUrl])
  @@index([userId])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ScrapeJob {
  id          String    @id @default(cuid())
  query       String
  queryType   String
  filtersKey  String    @default("{}")
  status      JobStatus @default(PENDING)
  results     Json?
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([query, queryType, filtersKey, status, completedAt])
}
