generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  hashedPassword   String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  savedComparisons SavedComparison[]

  @@index([email])
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  productUrl String
  platform   String
  price      Float
  currency   String
  recordedAt DateTime @default(now())

  @@unique([productUrl, platform])
  @@index([productUrl, platform, recordedAt])
}

model SavedComparison {
  id             Int      @id @default(autoincrement())
  userId         Int
  searchQuery    String
  searchType     String
  comparisonData String
  productUrl     String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, productUrl])
  @@index([userId])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ScrapeJob {
  id          String    @id @default(cuid())
  query       String
  queryType   String
  filtersKey  String    @default("{}")
  status      JobStatus @default(PENDING)
  results     Json?
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([query, queryType, filtersKey, status, completedAt])
}
